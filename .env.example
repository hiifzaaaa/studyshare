# Root StudyShare Environment Configuration Example
PORT=5000
NODE_ENV=development

# MongoDB Connection (Local or Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/studyshare
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/studyshare?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_here

# Frontend URL
FRONTEND_URL=https://studyshare-frontend.onrender.com

# Cloudinary Persistent Document Storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

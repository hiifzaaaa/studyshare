# Backend Environment Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection
# Local Development:
MONGODB_URI=mongodb://127.0.0.1:27017/studyshare
# Production (MongoDB Atlas):
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/studyshare?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here

# Frontend CORS Origin (in production, set to your Render frontend static site URL)
FRONTEND_URL=https://studyshare-frontend.onrender.com

# Cloudinary Storage for Permanent Document Uploads (Optional in local dev, recommended in production)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
